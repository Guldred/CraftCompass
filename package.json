{
  "name": "craftcompass",
  "version": "0.0.0",
  "private": true,
  "description": "Context-aware software craftsmanship and assurance.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.23.1 || ^24.18.0"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "craft": "pnpm --silent build && node apps/cli/dist/main.js",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --noEmit --pretty false"
  },
  "devDependencies": {
    "@craftcompass/cli": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
