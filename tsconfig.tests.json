{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@craftcompass/domain": ["./packages/domain/src/index.ts"],
      "@craftcompass/assurance-engine": [
        "./packages/assurance-engine/src/index.ts"
      ],
      "@craftcompass/instruction-compiler": [
        "./packages/instruction-compiler/src/index.ts"
      ],
      "@craftcompass/mutation-engine": [
        "./packages/mutation-engine/src/index.ts"
      ],
      "@craftcompass/providers-pitest": [
        "./packages/providers-pitest/src/index.ts"
      ],
      "@craftcompass/providers-filesystem": [
        "./packages/providers-filesystem/src/index.ts"
      ]
    }
  },
  "include": ["apps/**/*.test.ts", "packages/**/*.test.ts", "vitest.config.ts"]
}
