{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "types": ["node"],
    "paths": {
      "@craftcompass/domain": ["../../packages/domain/src/index.ts"],
      "@craftcompass/providers-filesystem": [
        "../../packages/providers-filesystem/src/index.ts"
      ]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    {
      "path": "../../packages/domain"
    },
    {
      "path": "../../packages/providers-filesystem"
    }
  ]
}
